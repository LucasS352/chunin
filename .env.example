# Configurações do Banco de Dados PostgreSQL
DATABASE_URL="postgresql://tutu:tutupassword@db:5432/tutu_db?schema=public"

# Credenciais do Usuário da Aplicação
APP_USERNAME=tutu
APP_PASSWORD=troque_por_uma_senha_forte_com_8_ou_mais_caracteres

# Senha separada do Sensei para criar, editar ou remover insígnias
ADMIN_PASSWORD=troque_por_uma_senha_que_o_aprendiz_nao_saiba

# Chave secreta de Sessão (troque por uma chave aleatória e segura em produção)
SESSION_SECRET=gere_uma_chave_aleatoria_unica_com_32_ou_mais_caracteres

# Ambiente e Porta
PORT=3000
NODE_ENV=production
